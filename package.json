{
  "name": "arkvault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project=unit-backend",
    "test:api": "vitest run --project=api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "s3:start": "docker run -d --name arkvault-minio -p 9000:9000 -p 9001:9001 -e \"MINIO_ROOT_USER=minioadmin\" -e \"MINIO_ROOT_PASSWORD=minioadmin\" minio/minio server /data --console-address \":9001\"",
    "s3:stop": "docker stop arkvault-minio && docker rm arkvault-minio",
    "nfs:start": "docker run -d --privileged --name arkvault-nfs -v /tmp/nfs-share:/nfsshare -e SHARED_DIRECTORY=/nfsshare -p 22049:2049 itsthenetwork/nfs-server-alpine:latest",
    "nfs:stop": "docker rm -f arkvault-nfs || true",
    "db:reset": "node scripts/reset-auth.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "googleapis": "^171.0.0",
    "lucide-react": "^0.563.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "supertest": "^7.2.2",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}